{
  "name": "promptshield",
  "version": "0.2.2",
  "description": "Leak and prompt-injection testing for chatbots and LLM apps, from your terminal or CI. Works with any HTTP API, OpenAI-compatible endpoints, Anthropic, Gemini and Ollama.",
  "bin": {
    "promptshield": "src/cli.js"
  },
  "files": [
  "src",
  "attacks/*.json",
  "examples",
  "vulnerable-bot",
  "docs",
  "README.md",
  "LICENSE",
  "SECURITY.md",
  "CHANGELOG.md",
  "UPGRADE.md",
  "promptshield.config.example.json"
],
  "scripts": {
    "bot": "node vulnerable-bot/server.js",
    "scan": "node src/cli.js scan --config examples/vulnerable-bot.config.json",
    "test": "node --test test/*.test.js",
    "check": "node --check src/cli.js && node --check src/scanner.js && npm test"
  },
  "keywords": [
    "llm",
    "security",
    "prompt-injection",
    "red-team",
    "chatbot",
    "ci",
    "sarif"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aditya-0519/promptshield.git"
  },
  "homepage": "https://github.com/Aditya-0519/promptshield#readme",
  "bugs": {
    "url": "https://github.com/Aditya-0519/promptshield/issues"
  }
}
